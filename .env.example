# Copy to .env and edit. Every setting the service and Docker Compose read is listed here.

# --- application (read by agentbounty.settings) ---
# development | test | production
APP_ENV=development
# Must use the asyncpg driver. This value is for processes run on the host (make test,
# uvicorn); containers get a URL that points at the "db" service instead.
DATABASE_URL=postgresql+asyncpg://agentbounty:change-me@localhost:5433/agentbounty

# The model API for real replays: an OpenAI-compatible chat completions endpoint, for
# example https://api.anthropic.com/v1/ or https://api.openai.com/v1. Leave both unset to
# run on the deterministic FakeModel, which needs no key.
# MODEL_API_BASE=
# MODEL_API_KEY=

# --- Docker Compose ---
POSTGRES_USER=agentbounty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentbounty
# Host ports. Both are bound to 127.0.0.1 only.
DB_PORT=5433
API_PORT=8000
