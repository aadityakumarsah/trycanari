# Copy to .env and edit. Every setting the service and Docker Compose read is listed here.

# --- application (read by agentbounty.settings) ---
# development | test | production
APP_ENV=development
# Must use the asyncpg driver. This value is for processes run on the host (make test,
# uvicorn); containers get a URL that points at the "db" service instead. Quote a URL
# that contains & or ?.
DATABASE_URL="postgresql+asyncpg://agentbounty:change-me@localhost:5433/agentbounty"

# A hosted Postgres behind a transaction-mode pooler (Supabase, port 6543): add
# pgbouncer=true so prepared-statement caching is switched off, and give migrations a
# session-mode or direct connection in DIRECT_URL.
# DATABASE_URL="postgresql+asyncpg://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&ssl=require"
# DIRECT_URL="postgresql+asyncpg://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?ssl=require"
# The tests create and drop databases. When DATABASE_URL is not a local server, name one here.
# TEST_DATABASE_URL="postgresql+asyncpg://localhost:5432/agentbounty"

# 32 random bytes, base64. Encrypts system prompts, tool definitions and canary secrets.
# Losing it makes those columns unreadable. Generate one with:
#   uv run python -c "from agentbounty.services.crypto import generate_key; print(generate_key())"
SECRET_ENCRYPTION_KEY=

# fake: the deterministic FakeModel, which needs no key and obeys whatever an attack says.
#       Refused when APP_ENV=production.
# real: an OpenAI-compatible chat completions endpoint, for example
#       https://api.anthropic.com/v1/ or https://api.openai.com/v1
MODEL_BACKEND=fake
# MODEL_API_BASE=
# MODEL_API_KEY=

# Recommended no-cost hosted setup: make a Groq key, then uncomment these values.
# TryCanari sends one request at a time, honors Groq's Retry-After response, retries short
# throttles and returns longer throttles to the durable queue. The budgets leave headroom
# below the current free-plan daily token limit; check your Groq console for your exact tier.
# MODEL_BACKEND=real
# MODEL_API_BASE=https://api.groq.com/openai/v1
# MODEL_API_KEY=gsk_your_key_here
# Use this production model when creating an agent config, and for attacker processes.
# ATTACKER_MODEL=openai/gpt-oss-20b

# fake:   an in-memory wallet. No network, no money. The default; refused in production.
# solana: rewards are paid in native SOL through an RPC node.
WALLET_BACKEND=fake

# WALLET_BACKEND=solana. ESCROW_ADDRESS is the escrow wallet's address, which sponsors
# deposit to; the fake wallet has a fixed address of its own. The wallet's secret key is
# needed only by the payment process, as a base58 string or the list of numbers in a
# keypair file. SOLANA_CLUSTER is devnet, testnet or mainnet-beta, and must be the
# cluster the RPC node belongs to.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_CLUSTER=devnet
# ESCROW_ADDRESS=
# SOLANA_SECRET_KEY=
# Caps on payouts to hunters, in lamports: per payment, and per rolling 24 hours.
# Unset means no cap. Both are required when APP_ENV=production.
# PAYOUT_MAX_ZATOSHI=
# PAYOUT_DAILY_MAX_ZATOSHI=

# The attacker agent only (python -m agentbounty.attacker): the model it thinks with.
# It uses MODEL_API_BASE and MODEL_API_KEY above.
# ATTACKER_MODEL=

# Sign in with Google, for sponsors. Leave unset to offer API keys only.
# Create an OAuth client of type "Web application" in the Google Cloud console with
#   Authorised JavaScript origin:  PUBLIC_URL
#   Authorised redirect URI:       PUBLIC_URL + /v1/auth/google/callback
# PUBLIC_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Set when a proxy sits in front of the API (the Cloudflare Pages worker has the same
# value). The API then believes the proxy about each caller's address.
# PROXY_SECRET=

# Invite-only mode. Anyone may make an account, but an attack must come from one that has
# redeemed a referral code, and it spends credits from that account's allowance for the
# last 24 hours. This is what keeps a stranger from running up the model bill. Codes are
# made on the Admin page, or with
#   python -m agentbounty.admin code --count 10
# INVITE_ONLY=false
# The owners: Google addresses, separated by commas, whose accounts are always admins.
# ADMIN_EMAILS=you@example.com
# STARTER_CREDITS=5
# PROVEN_CREDITS=25
# Extra tokens the first attack on a bounty costs, on top of its length price.
# NEW_BOUNTY_PREMIUM=2

# The Watch plan, for sponsors: scanning an unchanged agent again, a scan of every watched
# bounty each day, and the shared library of breaks. What it costs for PLAN_DAYS, in the
# currency's smallest unit (lamports). Unset or 0, there is no plan to buy and everyone
# has what it gives.
# PLAN_PRICE_ZATOSHI=0
# PLAN_DAYS=30

# Profile pictures people upload are kept at Cloudinary. Leave unset to switch uploading off.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Email about breaks and payouts. The bell on the site works whatever this is.
#   none        send nothing (the default)
#   fake        log what would be sent
#   cloudflare  send through Cloudflare Email Service
# For cloudflare: onboard a domain under Email Service in the Cloudflare dashboard, make
# an API token allowed to send email for the account, and send from an address on that
# domain. PUBLIC_URL must be set too, since the emails link back to the site. Only an
# account that signed in with Google is emailed: that is what proves the address.
# EMAIL_BACKEND=none
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_TOKEN=
# EMAIL_FROM=alerts@example.com
# EMAIL_FROM_NAME=trycanari

# Limits. These are the defaults.
# Requests a minute one client address may make to the public endpoints.
# RATE_LIMIT_PER_MINUTE=120
# Attempts an hour, per payout address and per bounty.
# ATTEMPTS_PER_ADDRESS_PER_HOUR=20
# ATTEMPTS_PER_BOUNTY_PER_HOUR=60
# Model tokens a bounty's replays may use in a rolling 24 hours.
# BOUNTY_DAILY_TOKEN_BUDGET=2000000
# The same for every bounty together: the ceiling on the whole platform's model bill.
# PLATFORM_DAILY_TOKEN_BUDGET=20000000
# Conservative Groq free-plan values instead of the general defaults:
# BOUNTY_DAILY_TOKEN_BUDGET=50000
# PLATFORM_DAILY_TOKEN_BUDGET=180000
# Sponsors may connect a model endpoint of their own. Those are reached only on the public
# internet. Set this only on your own machine, to try a model server running there.
# ALLOW_PRIVATE_MODEL_ENDPOINTS=false

# The house hunter: the platform's own attacker agent, run by the replay worker against
# every config that goes live, so that an agent is attacked from the day it is listed.
# It costs model calls: one to write each attack, and five replays to judge it. A break it
# finds is never paid for: the sponsor gets the attack, and the escrow is untouched.
# HOUSE_HUNTER=false
# The model it writes attacks with, on the platform's provider. Unset, it uses the model
# the agent under attack runs on.
# HOUSE_MODEL=
# Attacks it makes on one config.
# HOUSE_ATTEMPTS=5
# For the conservative Groq profile:
# HOUSE_MODEL=openai/gpt-oss-20b
# HOUSE_ATTEMPTS=2
# HOUSE_POLL_SECONDS=30

# Optional tuning; these are the defaults.
# FEE_RATE=0.1
# WORKER_POLL_SECONDS=2
# ATTEMPT_TIMEOUT_SECONDS=900
# ATTEMPT_MAX_TRIES=3
# DEPOSIT_CONFIRMATIONS=3
# PAYMENT_POLL_SECONDS=30
# With the fake wallet, the payment process makes awaited deposits arrive by themselves.
# FAKE_WALLET_AUTOFUND=true

# --- Docker Compose ---
POSTGRES_USER=agentbounty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentbounty
# Host ports. Both are bound to 127.0.0.1 only.
DB_PORT=5433
API_PORT=8000
